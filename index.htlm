<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Md Abu Zafar Al Munsur | Researcher</title>

    <meta name="description"
          content="Academic website of Dr. Md Abu Zafar Al Munsur, researcher in polymer electrolyte membranes, hydrogen energy, fuel cells and water electrolysis.">

    <meta name="author" content="Md Abu Zafar Al Munsur">

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">

    <!-- Icons -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <style>

        :root {
            --primary: #0b5ed7;
            --primary-dark: #063b88;
            --secondary: #0f766e;
            --dark: #111827;
            --text: #374151;
            --light-text: #6b7280;
            --background: #f8fafc;
            --white: #ffffff;
            --border: #e5e7eb;
            --card-shadow: 0 10px 30px rgba(15, 23, 42, 0.07);
            --max-width: 1180px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: "Inter", sans-serif;
            color: var(--text);
            background: var(--background);
            line-height: 1.7;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        img {
            max-width: 100%;
        }

        .container {
            width: min(92%, var(--max-width));
            margin: auto;
        }

        /================= NAVIGATION =================/

        nav {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background: rgba(255,255,255,0.95);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border);
            z-index: 1000;
        }

        .nav-container {
            max-width: var(--max-width);
            margin: auto;
            padding: 16px 4%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 1.1rem;
            font-weight: 800;
            color: var(--primary-dark);
        }

        .nav-links {
            display: flex;
            gap: 25px;
            list-style: none;
        }

        .nav-links a {
            font-size: 0.9rem;
            font-weight: 600;
            color: #374151;
            transition: 0.3s;
        }

        .nav-links a:hover {
            color: var(--primary);
        }

        .menu-btn {
            display: none;
            font-size: 1.5rem;
            cursor: pointer;
        }

        /================= HERO =================/

        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding-top: 90px;
            background:
                linear-gradient(135deg, #eef6ff 0%, #ffffff 55%, #ecfdf5 100%);
        }

        .hero-grid {
            display: grid;
            grid-template-columns: 1.3fr 0.7fr;
            gap: 60px;
            align-items: center;
        }

        .hero-label {
            display: inline-block;
            color: var(--primary);
            background: #e8f1ff;
            padding: 7px 14px;
            border-radius: 30px;
            font-size: 0.82rem;
            font-weight: 700;
            margin-bottom: 20px;
        }

        .hero h1 {
            font-family: "Playfair Display", serif;
            font-size: clamp(2.8rem, 6vw, 5rem);
            line-height: 1.08;
            color: var(--dark);
            margin-bottom: 20px;
        }

        .hero h1 span {
            color: var(--primary);
        }

        .hero h2 {
            font-size: 1.25rem;
            font-weight: 600;
            color: var(--secondary);
            margin-bottom: 20px;
        }

        .hero p {
            max-width: 720px;
            font-size: 1.05rem;
            color: var(--light-text);
            margin-bottom: 30px;
        }

        .hero-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 20px;
            border-radius: 8px;
            font-weight: 600;
            transition: 0.3s;
        }

        .btn-primary {
            background: var(--primary);
            color: white;
        }

        .btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
        }

        .btn-outline {
            border: 1px solid var(--border);
            background: white;
        }

        .btn-outline:hover {
            border-color: var(--primary);
            color: var(--primary);
        }

        .hero-card {
            background: white;
            padding: 35px;
            border-radius: 20px;
            box-shadow: var(--card-shadow);
            border: 1px solid var(--border);
        }

        .hero-card .profile-icon {
            width: 100px;
            height: 100px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 2.3rem;
            margin-bottom: 20px;
        }

        .hero-card h3 {
            color: var(--dark);
            margin-bottom: 8px;
        }

        .hero-card p {
            margin-bottom: 10px;
            font-size: 0.9rem;
        }

        / ================= SECTIONS ================= /

        section {
            padding: 90px 0;
        }

        .section-title {
            text-align: center;
            margin-bottom: 55px;
        }

        .section-title span {
            color: var(--primary);
            font-size: 0.85rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .section-title h2 {
            font-family: "Playfair Display", serif;
            font-size: 2.5rem;
            color: var(--dark);
            margin-top: 8px;
        }

        .section-title p {
            max-width: 700px;
            margin: 10px auto;
            color: var(--light-text);
        }

        /================= ABOUT ================= /

        .about-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 35px;
        }

        .about-card {
            background: white;
            padding: 35px;
            border-radius: 15px;
            border: 1px solid var(--border);
            box-shadow: var(--card-shadow);
        }

        .about-card h3 {
            color: var(--dark);
            margin-bottom: 15px;
        }

        .research-list {
            display: grid;
            gap: 14px;
        }

        .research-item {
            padding: 15px;
            border-left: 4px solid var(--primary);
            background: #f8fafc;
        }

        .research-item strong {
            color: var(--dark);
        }

        /================= EXPERIENCE =================/

        .timeline {
            position: relative;
            max-width: 900px;
            margin: auto;
        }

        .timeline::before {
            content: "";
            position: absolute;
            left: 15px;
            top: 0;
            width: 2px;
            height: 100%;
            background: #dbeafe;
        }

        .timeline-item {
            position: relative;
            padding-left: 55px;
            margin-bottom: 45px;
        }

        .timeline-dot {
            position: absolute;
            left: 6px;
            top: 5px;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: var(--primary);
            border: 4px solid #dbeafe;
        }

        .timeline-item h3 {
            color: var(--dark);
            font-size: 1.15rem;
        }

        .timeline-item .date {
            color: var(--primary);
            font-size: 0.88rem;
            font-weight: 700;
            margin: 4px 0;
        }

        .timeline-item .institution {
            font-weight: 600;
        }

        /================= PUBLICATIONS =================/

        .publication {
            background: white;
            padding: 25px 30px;
            margin-bottom: 18px;
            border-radius: 12px;
            border: 1px solid var(--border);
            transition: 0.3s;
        }

        .publication:hover {
            transform: translateY(-3px);
            box-shadow: var(--card-shadow);
        }

        .publication-number {
            color: var(--primary);
            font-weight: 800;
            margin-right: 8px;
        }

        .publication h3 {
            display: inline;
            color: var(--dark);
            font-size: 1rem;
        }

        .journal {
            color: var(--secondary);
            font-weight: 600;
        }

        .doi {
            display: inline-block;
            margin-top: 8px;
            color: var(--primary);
            font-size: 0.85rem;
            font-weight: 600;
        }

        .doi:hover {
            text-decoration: underline;
        }

        .pub-section {
            margin-bottom: 45px;
        }

        .pub-section h3 {
            color: var(--dark);
            margin-bottom: 20px;
            font-size: 1.5rem;
        }

        /================= PATENTS =================/

        .patent-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .patent {
            background: white;
            padding: 25px;
            border-radius: 12px;
            border: 1px solid var(--border);
        }

        .patent i {
            color: var(--primary);
            font-size: 1.4rem;
            margin-bottom: 12px;
        }

        .patent h3 {
            font-size: 1rem;
            color: var(--dark);
            margin-bottom: 8px;
        }

        .patent p {
            font-size: 0.88rem;
            color: var(--light-text);
        }

        /================= SKILLS =================/

        .skills-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .skill-card {
            background: white;
            padding: 28px;
            border-radius: 12px;
            border: 1px solid var(--border);
        }

        .skill-card h3 {
            color: var(--dark);
            margin-bottom: 15px;
        }

        .tags {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .tag {
            background: #eef6ff;
            color: var(--primary-dark);
            padding: 6px 10px;
            border-radius: 6px;
            font-size: 0.78rem;
            font-weight: 600;
        }

        /================= AWARDS =================/

        .award-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .award {
            background: white;
            padding: 25px;
            border-radius: 12px;
            border: 1px solid var(--border);
            display: flex;
            gap: 18px;
        }

        .award i {
            color: #d4a017;
            font-size: 1.7rem;
        }

        .award h3 {
            color: var(--dark);
            font-size: 1rem;
        }

        /================= STATS =================/

        .stats {
            background: var(--dark);
            color: white;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            text-align: center;
        }

        .stat h3 {
            font-size: 2.5rem;
            color: #60a5fa;
        }

        .stat p {
            color: #d1d5db;
            font-size: 0.9rem;
        }

        /================= REVIEW =================/

        .review-box {
            max-width: 850px;
            margin: auto;
            background: white;
            padding: 35px;
            border-radius: 15px;
            border: 1px solid var(--border);
            text-align: center;
        }

        .review-box i {
            font-size: 2rem;
            color: var(--primary);
            margin-bottom: 15px;
        }

        /================= CONTACT =================/

        .contact {
            background: #eef6ff;
        }

        .contact-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 35px;
        }

        .contact-card {
            background: white;
            padding: 35px;
            border-radius: 15px;
            border: 1px solid var(--border);
        }

        .contact-item {
            display: flex;
            gap: 15px;
            margin-bottom: 20px;
        }

        .contact-item i {
            color: var(--primary);
            width: 20px;
            margin-top: 5px;
        }

        .contact-item strong {
            display: block;
            color: var(--dark);
        }

        .social-links {
            display: flex;
            gap: 12px;
            margin-top: 25px;
        }

        .social-links a {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: #f1f5f9;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: 0.3s;
        }

        .social-links a:hover {
            background: var(--primary);
            color: white;
        }

        /================= FOOTER =================/

        footer {
            background: #0b1120;
            color: #94a3b8;
            text-align: center;
            padding: 30px 20px;
            font-size: 0.85rem;
        }

        footer strong {
            color: white;
        }

        /================= RESPONSIVE =================/

        @media (max-width: 900px) {

            .hero-grid,
            .about-grid,
            .contact-grid {
                grid-template-columns: 1fr;
            }

            .skills-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .patent-grid,
            .award-grid {
                grid-template-columns: 1fr;
            }

            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .nav-links {
                display: none;
                position: absolute;
                top: 65px;
                left: 0;
                width: 100%;
                background: white;
                flex-direction: column;
                padding: 25px;
                border-bottom: 1px solid var(--border);
            }

            .nav-links.active {
                display: flex;
            }

            .menu-btn {
                display: block;
            }
        }

        @media (max-width: 600px) {

            section {
                padding: 65px 0;
            }

            .hero h1 {
                font-size: 2.7rem;
            }

            .skills-grid {
                grid-template-columns: 1fr;
            }

            .stats-grid {
                grid-template-columns: 1fr 1fr;
            }

            .hero-card {
                padding: 25px;
            }
        }

    </style>
</head>


