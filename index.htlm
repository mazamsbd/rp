<!-- ================= ABOUT ================= -->

<section id="about">

    <div class="container">

        <div class="section-title">
            <span>About Me</span>
            <h2>Researcher & Materials Scientist</h2>
        </div>

        <div class="about-grid">

            <div class="about-card">

                <h3>Professional Profile</h3>

                <p>
                    I am a researcher working at the intersection of polymer
                    science, electrochemistry, membrane technology and
                    hydrogen energy.
                </p>

                <br>

                <p>
                    My research involves the design, synthesis,
                    characterization and application of functional polymers
                    and polymer electrolyte membranes for energy conversion,
                    hydrogen production and gas separation technologies.
                </p>

            </div>


            <div class="about-card">

                <h3>Academic Background</h3>

                <p>
                    <strong>Ph.D. in Chemistry</strong><br>
                    Incheon National University, South Korea
                </p>

                <br>

                <p>
                    Major: Organic Materials Synthesis
                </p>

                <br>

                <p>
                    <strong>M.Sc. in Chemistry</strong><br>
                    University of Rajshahi, Bangladesh
                </p>

                <br>

                <p>
                    <strong>B.Sc. in Chemistry</strong><br>
                    University of Rajshahi, Bangladesh
                </p>

            </div>

        </div>

    </div>

</section>


<!-- ================= RESEARCH ================= -->

<section id="research">

    <div class="container">

        <div class="section-title">

            <span>Research</span>

            <h2>Research Areas</h2>

            <p>
                Development of advanced polymeric materials for energy,
                electrochemical and separation applications.
            </p>

        </div>


        <div class="research-list">

            <div class="research-item">
                <strong>Hydrogen Energy</strong><br>
                Polymer electrolyte membranes, hydrogen production and
                electrochemical energy conversion.
            </div>

            <div class="research-item">
                <strong>Fuel Cells</strong><br>
                Proton exchange membrane fuel cells and anion exchange
                membrane fuel cells, including membrane electrode assemblies.
            </div>

            <div class="research-item">
                <strong>Water Electrolysis</strong><br>
                Development of low-cost and high-performance polymer
                electrolyte membranes for hydrogen generation.
            </div>

            <div class="research-item">
                <strong>Carbon Capture & Separation</strong><br>
                Development of robust polymeric membranes for CO₂ separation
                and sequestration.
            </div>

            <div class="research-item">
                <strong>Membrane Technology</strong><br>
                Nanofiltration membranes, ion-exchange membranes and
                advanced polymeric membrane architectures.
            </div>

            <div class="research-item">
                <strong>Advanced Polymer Materials</strong><br>
                Polymer synthesis, molecular design, interpenetrating polymer
                networks, functional polymers and nanocomposite membranes.
            </div>

        </div>

    </div>

</section>


